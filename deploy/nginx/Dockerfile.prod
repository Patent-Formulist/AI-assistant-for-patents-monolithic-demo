FROM nginx:alpine

# Удаляем дефолтную конфигурацию
RUN rm /etc/nginx/conf.d/default.conf

# Копируем основную конфигурацию nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Копируем конфигурацию сайта
COPY sites/00-monolith.prod.conf /etc/nginx/sites-enabled/00-monolith.prod.conf

# Общие proxy_set_header, подключаются через include snippets/proxy.conf
COPY snippets/ /etc/nginx/snippets/

# Создаем директорию для логов
RUN mkdir -p /var/log/nginx

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]