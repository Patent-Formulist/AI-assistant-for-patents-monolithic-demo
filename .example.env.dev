# Dev-стек (compose.dev.yaml):
#   cp .example.env.dev .env.dev
#   docker compose -f compose.dev.yaml --env-file .env.dev up -d --build

# Postgres. Пароль обязателен: compose не запустит стек, если он пуст.
# Существующий локальный том создан с паролем admin1admin.
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=formulist
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=formulinked-postgres-data

# Секреты бэкенда и воркера. Обязательны, JWT_SECRET_KEY не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ROSPATENT_API_KEY=

# ЮKassa (пополнение баланса). Необязательно: без магазина API оплаты отвечает 503.
# Ключи: личный кабинет ЮKassa -> Интеграция -> Ключи API. Уведомления там же
# (HTTP-уведомления): https://<домен>/api/v2/billing/payments/yookassa/notifications,
# события payment.succeeded и payment.canceled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда платёжная страница вернёт пользователя
PAYMENT_RETURN_URL=http://localhost/profile

# Почта для подтверждения email. Необязательно: без SMTP_HOST письма пишутся в лог бэкенда
# (на dev ссылку можно взять оттуда). Порт 587 — STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Страница фронтенда, которая подтверждает email: <url>?token=...
EMAIL_VERIFICATION_URL=http://localhost/verify-email

# Мониторинг worker'а. Необязательно: ping-URL проверки в healthchecks.io (бесплатно).
# Worker раз в минуту дёргает его, если база и Temporal отвечают, и <url>/fail, если нет;
# тишина дольше периода — алерт (worker упал или завис).
WORKER_HEARTBEAT_URL=

# Sentry: ошибки API и worker'а с контекстом. Необязательно: DSN проекта (sentry.io,
# бесплатный тариф); пусто — ошибки никуда не отправляются.
SENTRY_DSN=

# Алерты администраторам в Telegram. Необязательно: токен бота от @BotFather; получатели —
# администраторы с tg_id (scripts/make_admin.py <email> --tg-id <id>). Пусто — алерты в лог.
TELEGRAM_BOT_TOKEN=

# Пути (относительно корня репозитория)
FRONTEND_PATH=../Patent-Formulist-web-app
FRONTEND_DOCKER_FILE_PATH=Dockerfile.dev
NGINX_PATH=./deploy/nginx
NGINX_DOCKER_FILE_PATH=Dockerfile.dev
NGINX_CONF_PATH=./deploy/nginx/sites/00-monolith.dev.conf
