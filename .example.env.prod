# Prod-стек (compose.prod.yaml), на сервере:
#   cp .example.env.prod .env.prod
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d

OPERATING_MODE=prod

POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_CONTAINER_NAME=formulinked-postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=formulist

BACKEND_IMAGE=muschketl/formulinked-backend:latest
BACKEND_CONTAINER_NAME=formulinked-monolith
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Секреты бэкенда и воркера. Обязательны, как и POSTGRES_PASSWORD:
# compose.prod.yaml не запустит стек, если какой-то из них пуст.
# JWT_SECRET_KEY не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ROSPATENT_API_KEY=

# ЮKassa (пополнение баланса). Необязательно: без магазина API оплаты отвечает 503.
# Ключи: личный кабинет ЮKassa -> Интеграция -> Ключи API. Уведомления там же
# (HTTP-уведомления): https://<домен>/api/v2/billing/payments/yookassa/notifications,
# события payment.succeeded и payment.canceled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда платёжная страница вернёт пользователя
PAYMENT_RETURN_URL=https://<домен>/profile

# Почта для подтверждения email. Необязательно: без SMTP_HOST письма пишутся в лог бэкенда
# (на dev ссылку можно взять оттуда). Порт 587 — STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Страница фронтенда, которая подтверждает email: <url>?token=...
EMAIL_VERIFICATION_URL=https://<домен>/verify-email

# Мониторинг worker'а. Необязательно: ping-URL проверки в healthchecks.io (бесплатно).
# Worker раз в минуту дёргает его, если база и Temporal отвечают, и <url>/fail, если нет;
# тишина дольше периода — алерт (worker упал или завис).
WORKER_HEARTBEAT_URL=

# Sentry: ошибки API и worker'а с контекстом. Необязательно: DSN проекта (sentry.io,
# бесплатный тариф); пусто — ошибки никуда не отправляются.
SENTRY_DSN=

# Алерты администраторам в Telegram. Необязательно: токен бота от @BotFather; получатели —
# администраторы с tg_id (scripts/make_admin.py <email> --tg-id <id>). Пусто — алерты в лог.
TELEGRAM_BOT_TOKEN=

FRONTEND_IMAGE=muschketl/formulinked-frontend:latest
FRONTEND_CONTAINER_NAME=formulinked-frontend

NGINX_IMAGE=muschketl/formulinked-nginx:latest
NGINX_CONTAINER_NAME=formulinked-nginx
NGINX_CONF_PATH=./deploy/nginx/sites/00-monolith.prod.conf

CERTBOT_IMAGE=certbot/certbot:latest
CERTBOT_CONTAINER_NAME=formulinked-certbot

# Имена существующих томов на сервере.
# Compose больше не берёт префикс из имени папки, поэтому имена задаются явно.
# Посмотреть фактические:  docker volume ls | grep -e postgres -e certbot
POSTGRES_VOLUME_NAME=deployment-orchestrator_postgres-data
CERTBOT_CONF_VOLUME_NAME=deployment-orchestrator_certbot-conf
CERTBOT_WWW_VOLUME_NAME=deployment-orchestrator_certbot-www
